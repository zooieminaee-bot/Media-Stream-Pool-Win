<Page
    x:Class="MediaStreamPool.App.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <Grid MaxWidth="900" HorizontalAlignment="Center">
            <StackPanel Spacing="22">
                <StackPanel Spacing="6">
                    <TextBlock Text="Media Stream Pool" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock Text="Native Windows media endpoint and authorized API analysis workspace" FontSize="18" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>

                <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Application" FontSize="20" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="20" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Version" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="1.0.0" />
                            <TextBlock Grid.Row="1" Text="Platform" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Windows x64" />
                            <TextBlock Grid.Row="2" Text="UI" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="WinUI 3 / Windows App SDK" />
                            <TextBlock Grid.Row="3" Text="Storage" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="SQLite" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Purpose" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Media Stream Pool indexes media endpoints and authorized API payloads discovered through the scanner, then keeps searchable records locally." TextWrapping="Wrap" Opacity="0.8" />
                        <TextBlock Text="It is designed as a native Windows desktop application with no browser or localhost UI dependency." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </Border>

                <Border Padding="22" CornerRadius="14" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Responsible use" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Use the scanner only with sources you are authorized to access. Do not use the application to bypass DRM, authentication, access controls, or service restrictions." TextWrapping="Wrap" Opacity="0.8" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
