<Page
    x:Class="MediaStreamPool.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="1000">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Application preferences and local runtime information" Opacity="0.7" />
            </StackPanel>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Theme follows your Windows appearance setting. The application uses native WinUI theme resources." TextWrapping="Wrap" Opacity="0.75" />
                    <ComboBox x:Name="ThemeComboBox" Header="Theme" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged" Width="260">
                        <ComboBoxItem Content="System default" />
                        <ComboBoxItem Content="Light" />
                        <ComboBoxItem Content="Dark" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Local data" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Database" FontWeight="SemiBold" />
                    <TextBlock x:Name="DatabasePathText" TextWrapping="Wrap" Opacity="0.75" />
                    <TextBlock Text="Startup diagnostics" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="DiagnosticsPathText" TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>

            <Border Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Security" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Only scan sources you are authorized to access. The application does not bypass DRM, authentication, access controls, or service restrictions." TextWrapping="Wrap" Opacity="0.75" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
