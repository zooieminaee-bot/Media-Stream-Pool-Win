<Page
    x:Class="MediaStreamPool.App.Pages.ScannerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="20" MaxWidth="1000">
            <StackPanel Spacing="4">
                <TextBlock Text="Scanner" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Analyze a source you are authorized to access." Opacity="0.7" />
            </StackPanel>
            <TextBox x:Name="SourceTextBox" Header="Source URL" PlaceholderText="https://example.invalid/source" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="ScanButton" Content="Start scan" Click="ScanButton_Click" />
                <ProgressBar x:Name="Progress" Width="280" Minimum="0" Maximum="1" Visibility="Collapsed" />
            </StackPanel>
            <InfoBar x:Name="StatusBar" IsOpen="False" />
            <TextBlock x:Name="ResultSummary" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
