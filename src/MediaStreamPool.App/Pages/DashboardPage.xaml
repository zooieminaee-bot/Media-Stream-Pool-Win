<Page
    x:Class="MediaStreamPool.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="24" MaxWidth="1280">
            <StackPanel Spacing="4">
                <TextBlock Text="Dashboard" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Live statistics from the local SQLite index" Opacity="0.7" />
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8"><TextBlock Text="Total Records" /><TextBlock Text="{Binding TotalRecords}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8"><TextBlock Text="Streams" /><TextBlock Text="{Binding Streams}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8"><TextBlock Text="APIs" /><TextBlock Text="{Binding Apis}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="20" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="8"><TextBlock Text="Decoded Payloads" /><TextBlock Text="{Binding DecodedPayloads}" FontSize="30" FontWeight="SemiBold" /></StackPanel>
                </Border>
            </Grid>
            <InfoBar IsOpen="True" Severity="Informational" Title="System status" Message="{Binding Status}" />
            <StackPanel Spacing="10">
                <TextBlock Text="Recent scans" FontSize="20" FontWeight="SemiBold" />
                <ListView ItemsSource="{Binding RecentScans}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12" Margin="0,0,0,6" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SourceUrl}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RecordsFound}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding StartedAt}" VerticalAlignment="Center" Opacity="0.65" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Text="No scans have been recorded yet." Opacity="0.6" HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
